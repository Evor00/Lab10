@model Habitacion
@{ ViewData["Title"] = "Detalle de habitación"; }
<h1 class="h2">Habitación @Model.Numero</h1>
<dl class="row mt-3 col-md-6"><dt class="col-sm-4">Tipo</dt><dd class="col-sm-8">@Model.TipoHabitacion.Nombre</dd><dt class="col-sm-4">Precio/noche</dt><dd class="col-sm-8">@Model.TipoHabitacion.PrecioNoche.ToString("C")</dd><dt class="col-sm-4">Estado</dt><dd class="col-sm-8">Activa</dd></dl>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.IdHabitacion">Editar</a> <a class="btn btn-link" asp-action="Index">Volver</a>
