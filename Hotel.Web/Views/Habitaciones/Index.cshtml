@model IEnumerable<Habitacion>
@{
    ViewData["Title"] = "Habitaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="h2 mb-0">Habitaciones activas</h1><p class="text-secondary mb-0">Filtra por tipo y administra el inventario.</p></div>
    <a class="btn btn-primary" asp-action="Create">Nueva habitación</a>
</div>
<form method="get" class="row g-2 mb-4">
    <div class="col-sm-4"><select name="tipoId" class="form-select" asp-items="@(ViewData["Tipos"] as SelectList)"><option value="">Todos los tipos</option></select></div>
    <div class="col-sm-auto"><button class="btn btn-outline-secondary" type="submit">Filtrar</button></div>
</form>
<div class="table-responsive"><table class="table table-hover align-middle">
    <thead><tr><th>Número</th><th>Tipo</th><th>Precio por noche</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>@foreach (var item in Model) { <tr><td class="fw-semibold">@item.Numero</td><td>@item.TipoHabitacion.Nombre</td><td>@item.TipoHabitacion.PrecioNoche.ToString("C")</td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.IdHabitacion">Ver</a> <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.IdHabitacion">Editar</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.IdHabitacion">Desactivar</a></td></tr> }</tbody>
</table></div>
